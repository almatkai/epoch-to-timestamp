{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "epoch-to-timestamp",
  "title": "Epoch to Timestamp",
  "description": "Quickly convert a Unix epoch, in seconds or milliseconds, to a human-readible timestamp.",
  "icon": "assets/extension-icon.png",
  "author": "almatkai",
  "contributors": ["bgreenlee"],
  "categories": ["Developer Tools"],
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "commands": [
    {
      "name": "epoch",
      "title": "Epoch",
      "description": "Convert a Unix epoch in your clipboard, in seconds or milliseconds, to a human-readible timestamp.",
      "mode": "no-view",
      "platforms": ["macOS", "Windows"]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.epoch-to-timestamp",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": ["macos", "windows"],
    "repository": "https://github.com/almatkai/epoch-to-timestamp",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/epoch-to-timestamp",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    },
    "linuxStatus": "coming-soon"
  }
}
